# GOV SIM backend configuration. Copy to `.env` and fill in as needed.
# All variables are optional; the app boots with safe defaults.

GOVSIM_ENVIRONMENT=development

# Comma-separated allowed CORS origins (the frontend dev server).
GOVSIM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional LLM key for the AI layer (policy parsing, parliament debate + ask,
# press conferences). When unset, every AI endpoint degrades to a deterministic
# rule-based/template fallback and still returns 200 — nothing breaks without a
# key, it just reads less fluently. Get an Anthropic key at
# https://console.anthropic.com/settings/keys and paste it below.
# Do NOT commit real keys — this file is the example; copy it to `.env`.
GOVSIM_LLM_API_KEY=
# LLM provider/model used only for language structuring (never numeric effects).
GOVSIM_LLM_PROVIDER=anthropic
GOVSIM_LLM_MODEL=claude-3-5-haiku-latest
GOVSIM_LLM_BASE_URL=https://api.anthropic.com
GOVSIM_LLM_TIMEOUT_S=20

# --- persistence -----------------------------------------------------------
# Local MongoDB. The API runs without it (no run history / model registry),
# so leaving these at their defaults is fine for a local demo.
GOVSIM_MONGO_URI=mongodb://127.0.0.1:27017
GOVSIM_MONGO_DB=govsim
